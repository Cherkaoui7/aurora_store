# AURORA Backend Environment Configuration (Node.js / Express)

# Server Port
PORT=4000

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aurora_store?retryWrites=true&w=majority

# JWT Secret for Token Signing
JWT_SECRET=your_jwt_secret_key_change_in_production

# Admin Credentials for Admin Panel Login (/api/admin/login)
ADMIN_EMAIL=admin@aurora.com
ADMIN_PASSWORD=admin123

# CORS Allowed Origins
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Cloudinary Storage Configuration (Optional - falls back to Base64 in MongoDB if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Secret Key (Optional - for payment gateway integration)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
