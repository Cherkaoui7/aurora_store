# AURORA Storefront Environment Configuration (Vite + React)

# Backend API URL
# For local development with backend running on port 4000:
VITE_API_URL=http://localhost:4000

# Legacy CRA variable (backward compatibility):
REACT_APP_API_URL=http://localhost:4000

# For Vercel production deployment (same-origin):
# Leave empty or omit so requests use relative paths (e.g., /api/...)
# VITE_API_URL=
